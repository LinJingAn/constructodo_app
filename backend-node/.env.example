# Construtodo Node Backend - same APIs as FastAPI backend
# Copy to .env and fill in.

PORT=8001
NODE_ENV=development

# PostgreSQL (same as Python backend)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=constructodo
# Set to 1 to start even when DB is down (default: fail if DB unreachable)
# CONSTRUCTODO_DB_OPTIONAL=1

# JWT (must match Python backend for same tokens if needed, or use same secret)
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Frontend
FRONTEND_URL=http://localhost:5173
# Optional: path to built frontend (frontend/dist). If set and folder exists, backend serves the SPA.
# FRONTEND_DIST=/var/www/constructodo/frontend/dist


